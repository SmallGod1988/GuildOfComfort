# --- Локальная разработка (npm run dev) ---
DATABASE_URL="postgresql://goc:goc@localhost:5432/guild_of_comfort?schema=public"
AUTH_SECRET="generate-a-long-random-string-for-this"

# --- Дополнительно нужно для docker-compose.prod.yml (см. DEPLOY.md) ---
# POSTGRES_USER="goc"
# POSTGRES_PASSWORD="set-a-strong-password"
# POSTGRES_DB="guild_of_comfort"

# --- Используются один раз сид-скриптом (npx prisma db seed) ---
# ADMIN_EMAIL="you@company.com"
# ADMIN_PASSWORD="set-a-strong-password"

# --- HTTPS ---
# Оставьте не заданным (или false), пока сайт открывается по http://IP:3000 —
# браузеры отказываются сохранять "Secure"-cookie без HTTPS, и вход не
# сработает, если включить это раньше времени. Поставьте true только после
# того, как настроите домен + HTTPS (см. Caddyfile.example в DEPLOY.md).
# COOKIE_SECURE="true"

# --- Email (SMTP) ---
# Для локальной разработки можно использовать Ethereal Email (временный SMTP тест-сервис)
# или настроить реальный SMTP (Gmail, SendGrid, своей хостинг-компании и т.д.)
# SMTP_HOST="smtp.ethereal.email"
# SMTP_PORT="587"
# SMTP_USER="your-email@ethereal.email"
# SMTP_PASSWORD="your-ethereal-password"
# SMTP_FROM="Guild of Comfort <noreply@example.com>"

# Сроки действия токенов
# EMAIL_VERIFICATION_EXPIRES_IN="7d"
# PASSWORD_RESET_EXPIRES_IN="24h"
