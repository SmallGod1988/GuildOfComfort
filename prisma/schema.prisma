// Prisma schema for GuildOfComfort — учёт монтажных работ (автоматика,
// вентиляция, электрика, кондиционирование).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  INSTALLER
  CUSTOMER
}

enum SiteStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum TaskStatus {
  FREE // создана, не закреплена
  ASSIGNED // закреплена за монтажником, ещё не начата
  IN_PROGRESS // монтажник выполняет
  PAUSED // приостановлена монтажником (причина обязательна)
  BLOCKED // заблокирована внешней причиной (причина обязательна)
  IN_REVIEW // выполнена монтажником, ждёт приёмки
  DONE // принята
}

enum WarehouseTxType {
  IN // приход на склад
  OUT // списание (обычно по задаче)
}

enum FinancialRecordType {
  ACCRUAL // начисление (к выплате)
  PAYOUT // выплата
}

// Пользователь системы: администратор, монтажник или заказчик.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  fullName     String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // как заказчик
  sitesAsCustomer Site[] @relation("CustomerSites")

  // как монтажник
  assignedSites         SiteInstaller[]
  assignedTasks         Task[]                @relation("AssignedInstaller")
  taskStatusEvents      TaskStatusEvent[]
  timesheetEntries      TimesheetEntry[]
  warehouseTransactions WarehouseTransaction[]

  // финансы: записи, где этот пользователь — участник расчёта
  financialRecordsAsParticipant FinancialRecord[] @relation("FinancialParticipant")
  // финансы: записи, которые этот пользователь (админ) создал
  financialRecordsCreated       FinancialRecord[] @relation("FinancialCreatedBy")

  @@map("users")
}

// Объект монтажа.
model Site {
  id         String     @id @default(cuid())
  name       String
  address    String
  customerId String
  customer   User       @relation("CustomerSites", fields: [customerId], references: [id])
  status     SiteStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  subProjects      SubProject[]
  installers       SiteInstaller[]
  warehouse        Warehouse?
  timesheetEntries TimesheetEntry[]
  financialRecords FinancialRecord[]

  @@map("sites")
}

// Монтажники, назначенные на объект (многие-ко-многим).
model SiteInstaller {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  installerId String
  installer   User     @relation(fields: [installerId], references: [id])
  assignedAt  DateTime @default(now())

  @@unique([siteId, installerId])
  @@map("site_installers")
}

// Подпроект объекта (например: вентиляция, электрика, кондиционирование).
model SubProject {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@map("sub_projects")
}

// Справочник операций. В будущем может подтягиваться из коммерческих
// предложений — пока ведётся вручную администратором.
model Operation {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  tools       String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  techCardMaterials TechCardMaterial[]
  tasks             Task[]

  @@map("operations")
}

// Технологическая карта операции: сколько какого материала расходуется.
model TechCardMaterial {
  id          String    @id @default(cuid())
  operationId String
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material  @relation(fields: [materialId], references: [id])
  quantity    Decimal   @db.Decimal(12, 3)

  @@unique([operationId, materialId])
  @@map("tech_card_materials")
}

// Задача: конкретная работа в рамках подпроекта, базируется на операции.
model Task {
  id           String     @id @default(cuid())
  subProjectId String
  subProject   SubProject @relation(fields: [subProjectId], references: [id], onDelete: Cascade)
  operationId  String
  operation    Operation  @relation(fields: [operationId], references: [id])
  title        String
  description  String?
  status       TaskStatus @default(FREE)

  installerId String?
  installer   User?   @relation("AssignedInstaller", fields: [installerId], references: [id])

  assignedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents          TaskStatusEvent[]
  warehouseTransactions WarehouseTransaction[]

  @@map("tasks")
}

// История переходов статуса задачи (для пауз/блокировок обязательна причина).
model TaskStatusEvent {
  id          String     @id @default(cuid())
  taskId      String
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus  TaskStatus
  toStatus    TaskStatus
  reason      String?
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())

  @@map("task_status_events")
}

// Справочник материалов (саморезы, гайки, болты и т.д.).
model Material {
  id        String   @id @default(cuid())
  name      String
  unit      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  techCardEntries       TechCardMaterial[]
  stock                 WarehouseStock[]
  warehouseTransactions WarehouseTransaction[]

  @@map("materials")
}

// Склад объекта — по одному на объект.
model Warehouse {
  id        String   @id @default(cuid())
  siteId    String   @unique
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  stock        WarehouseStock[]
  transactions WarehouseTransaction[]

  @@map("warehouses")
}

// Текущий остаток материала на складе объекта.
model WarehouseStock {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material  @relation(fields: [materialId], references: [id])
  quantity    Decimal   @default(0) @db.Decimal(12, 3)

  @@unique([warehouseId, materialId])
  @@map("warehouse_stock")
}

// Движение материала на складе: приход или списание (обычно по задаче).
model WarehouseTransaction {
  id          String          @id @default(cuid())
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material        @relation(fields: [materialId], references: [id])
  type        WarehouseTxType
  quantity    Decimal         @db.Decimal(12, 3)
  taskId      String?
  task        Task?           @relation(fields: [taskId], references: [id])
  note        String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@map("warehouse_transactions")
}

// Табель рабочего времени монтажника.
model TimesheetEntry {
  id          String   @id @default(cuid())
  installerId String
  installer   User     @relation(fields: [installerId], references: [id])
  siteId      String?
  site        Site?    @relation(fields: [siteId], references: [id])
  date        DateTime @db.Date
  hours       Decimal  @db.Decimal(4, 2)
  note        String?
  createdAt   DateTime @default(now())

  @@map("timesheet_entries")
}

// Приватные финансовые записи по участникам (видны только admin и самому
// участнику по своим записям).
model FinancialRecord {
  id            String              @id @default(cuid())
  participantId String
  participant   User                @relation("FinancialParticipant", fields: [participantId], references: [id])
  siteId        String?
  site          Site?               @relation(fields: [siteId], references: [id])
  type          FinancialRecordType
  amount        Decimal             @db.Decimal(12, 2)
  note          String?
  createdById   String
  createdBy     User                @relation("FinancialCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime            @default(now())

  @@map("financial_records")
}
